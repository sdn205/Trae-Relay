{
  "version": 1,
  "service": {
    "host": "127.0.0.1",
    "port": 8317,
    "allowLan": false,
    "apiKey": "",
    "allowAnyApiKey": false,
    "apiKeyProtected": false,
    "upstreamTimeoutSec": 120,
    "firstEventTimeoutSec": 120,
    "maxConcurrentPerAccount": 2,
    "minRequestIntervalMs": 0
  },
  "startup": {
    "autoStart": false,
    "startMinimizedToTray": true,
    "minimizeToTrayOnClose": true,
    "trayClickAction": "show",
    "singleInstance": true
  },
  "channel": {
    "prefer": "remote",
    "fallback": ["raw", "solo"],
    "ideVersion": { "remote": "3.3.102", "raw": "3.3.102", "solo": "0.1.52" },
    "ideVersionCode": { "remote": "20260912", "raw": "20260912", "solo": "20260811" }
  },
  "defaults": {
    "reasoningEffort": null,
    "isMaxMode": 0,
    "maxContextWindow": null,
    "stream": false,
    "autoContinue": true,
    "maxAutoContinue": 10,
    "effortMode": "auto"
  },
  "responses": {
    "enabled": true,
    "mapReasoningSummary": true,
    "sessionCacheSize": 64,
    "sessionCachePersist": false
  },
  "search": {
    "mode": "auto",
    "provider": "searxng",
    "endpoint": "",
    "apiKey": "",
    "maxResults": 5,
    "timeoutSec": 20,
    "nativeAgentType": "search_agent",
    "exposeAsTool": true,
    "resultCharsPerItem": 2000
  },
  "accounts": {
    "autoDiscover": true,
    "checkin": { "enabled": true, "hour": 10 },
    "pool": { "selectBy": "credits", "cooldownSec": 60, "disableAfterFails": 5 }
  },
  "logging": {
    "level": "info",
    "dir": "",
    "retainDays": 7,
    "redactSecrets": true
  }
}
