{
  "version": 1,
  "service": {
    "host": "127.0.0.1",
    "port": 8317,
    "allowLan": false,
    "apiKey": "",
    "allowAnyApiKey": false,
    "apiKeyProtected": false,
    "upstreamTimeoutSec": 120,
    "firstEventTimeoutSec": 120,
    "maxConcurrentPerAccount": 2,
    "minRequestIntervalMs": 0
  },
  "startup": {
    "autoStart": false,
    "startMinimizedToTray": true,
    "minimizeToTrayOnClose": true,
    "trayClickAction": "show",
    "singleInstance": true
  },
  "defaults": {
    "reasoningEffort": null,
    "isMaxMode": 0,
    "maxContextWindow": null,
    "stream": false,
    "autoContinue": true,
    "maxAutoContinue": 10
  },
  "responses": {
    "enabled": true,
    "mapReasoningSummary": true,
    "sessionCacheSize": 64,
    "sessionCachePersist": false
  },
  "accounts": {
    "autoDiscover": true,
    "checkin": { "enabled": true, "hour": 10, "minute": 0 },
    "pool": { "selectBy": "credits", "cooldownSec": 60, "disableAfterFails": 5 }
  },
  "logging": {
    "level": "info",
    "dir": "",
    "retainDays": 7,
    "redactSecrets": true
  },
  "models": {}
}
